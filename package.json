{
  "name": "websecurity",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:attacker": "node scripts/csrf-attacker.mjs",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate:slides": "pnpm --filter @ws/slides-schema validate",
    "e2e": "pnpm --filter @ws/talk e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
